<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="be.esi.dev.oxono.controller.fxml.PlayerInformationController"
            stylesheets="@../style/playerInformation.css">

    <StackPane minWidth="200">
        <VBox alignment="CENTER" spacing="30">
            <Label text="Player Information" styleClass="label-title"/>
            <VBox alignment="CENTER" spacing="10">
                <Label fx:id="player1InfoLabel" text="Pink Player" />
                <HBox alignment="CENTER" spacing="10">
                    <Label text="X :" />
                    <Label fx:id="player1XTokensLabel" text="0" />
                </HBox>
                <HBox alignment="CENTER" spacing="10">
                    <Label text="O :" />
                    <Label fx:id="player1OTokensLabel" text="0" />
                </HBox>
            </VBox>

            <VBox alignment="CENTER" spacing="10">
                <Label fx:id="player2InfoLabel" text="Black Player" />
                <HBox alignment="CENTER" spacing="10">
                    <Label text="X :" />
                    <Label fx:id="player2XTokensLabel" text="0" />
                </HBox>
                <HBox alignment="CENTER" spacing="10">
                    <Label text="O :" />
                    <Label fx:id="player2OTokensLabel" text="0" />
                </HBox>
            </VBox>
        </VBox>
    </StackPane>
</AnchorPane>
