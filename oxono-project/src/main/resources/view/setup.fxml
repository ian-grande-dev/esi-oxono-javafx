<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import java.lang.String?>

<?import javafx.collections.FXCollections?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="be.esi.dev.oxono.controller.fxml.SetupController"
            prefHeight="400.0" prefWidth="600.0"
            stylesheets="@../style/setup.css">

    <VBox alignment="CENTER" spacing="20.0" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Welcome to Oxono!" styleClass="label-title">
            <font>
                <Font name="Arial Bold" size="24.0" />
            </font>
        </Label>

        <VBox alignment="CENTER" spacing="5.0">
            <Label text="Player 1 Level"/>
            <ComboBox fx:id="player1LevelComboBox" promptText="Select Level">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Human"/>
                        <String fx:value="Bot (easy)"/>
                        <String fx:value="Bot (medium)"/>
                    </FXCollections>
                </items>
                <value>
                    <String fx:value="Human"/>
                </value>
            </ComboBox>
        </VBox>

        <VBox alignment="CENTER" spacing="5.0">
            <Label text="Player 2 Level"/>
            <ComboBox fx:id="player2LevelComboBox" promptText="Select Level">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Human"/>
                        <String fx:value="Bot (easy)"/>
                        <String fx:value="Bot (medium)"/>
                    </FXCollections>
                </items>
                <value>
                    <String fx:value="Bot (easy)"/>
                </value>
            </ComboBox>
        </VBox>

        <VBox alignment="CENTER" spacing="5.0">
            <Label text="Board Size (recommendation : 4-10)"/>
            <TextField fx:id="boardSizeField" promptText="Enter size" text="6" maxWidth="100"/>
            <Label fx:id="statusMessageLabel" />
        </VBox>

        <Button fx:id="startButton" text="Start Game" onAction="#handleStartGame">
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </Button>
    </VBox>
</AnchorPane>
